{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:storefront",
    "dev:storefront": "vite --config apps/storefront/vite.config.ts --host 127.0.0.1 --port 5173",
    "dev:cloudops": "vite --config apps/cloudops/vite.config.ts --host 127.0.0.1 --port 5174",
    "build": "npm run build:storefront && npm run build:cloudops",
    "build:storefront": "tsc --noEmit -p apps/storefront/tsconfig.json && vite build --config apps/storefront/vite.config.ts",
    "build:cloudops": "tsc --noEmit -p apps/cloudops/tsconfig.json && vite build --config apps/cloudops/vite.config.ts",
    "lint": "oxlint apps/storefront/src apps/cloudops/src",
    "preview:storefront": "vite preview --config apps/storefront/vite.config.ts --host 127.0.0.1 --port 4173",
    "preview:cloudops": "vite preview --config apps/cloudops/vite.config.ts --host 127.0.0.1 --port 4174",
    "test:smoke": "node scripts/smoke-frontends.cjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.43.0",
    "oidc-client-ts": "^3.5.0",
    "radix-ui": "^1.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-oidc-context": "^3.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "puppeteer": "^25.10.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
