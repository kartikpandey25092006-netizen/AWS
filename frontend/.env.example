# Storefront public browser configuration. These values are not secrets.
VITE_STOREFRONT_API_URL=http://127.0.0.1:3100
VITE_STOREFRONT_COGNITO_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_REPLACE_ME
VITE_STOREFRONT_COGNITO_CLIENT_ID=REPLACE_ME
VITE_CLOUDOPS_URL=http://localhost:5174/

# CloudOps shares the Storefront Cognito authority/client for administrator SSO.
# Keep these two values identical to VITE_STOREFRONT_COGNITO_* above.
VITE_API_URL=https://REPLACE_ME.execute-api.us-east-1.amazonaws.com
VITE_COGNITO_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_REPLACE_ME
VITE_COGNITO_CLIENT_ID=REPLACE_ME
VITE_STOREFRONT_URL=http://localhost:5173/
