{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowStorefrontCloudFrontDistribution",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudfront.amazonaws.com"
      },
      "Action": "lambda:InvokeWebFunctionEndpoint",
      "Resource": "arn:aws:lambda:us-east-1:325381793128:web-function/fieldwork-store-api-web/endpoint/storefront",
      "Condition": {
        "StringEquals": {
          "aws:SourceArn": "arn:aws:cloudfront::325381793128:distribution/EXOWA1YGQR32N"
        }
      }
    }
  ]
}
