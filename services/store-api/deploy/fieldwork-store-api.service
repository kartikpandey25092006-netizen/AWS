[Unit]
Description=Fieldwork Store API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fieldwork-store-api
Group=fieldwork-store-api
WorkingDirectory=/opt/fieldwork/store-api/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/fieldwork/store-api.env
ExecStart=/usr/bin/node-22 src/server.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
