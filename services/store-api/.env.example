# Store API runtime. This file contains names and non-secret examples only.
PORT=3100
STOREFRONT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STORE_COGNITO_USER_POOL_ID=us-east-1_example
STORE_COGNITO_APP_CLIENT_ID=example-public-spa-client-id

# Durable storage. DynamoDB uses the AWS credential provider chain; no database password is used.
STORE_DATABASE=dynamodb
AWS_REGION=us-east-1
STORE_DYNAMODB_TABLE=fieldwork-store-commerce
# Optional for a local DynamoDB-compatible endpoint only:
# STORE_DYNAMODB_ENDPOINT=http://localhost:8000

# For local development only, set AWS_PROFILE in the PowerShell session.
# Do not use STORE_DATABASE=memory when verifying saved-order behavior.
